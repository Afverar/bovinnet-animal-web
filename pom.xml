<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.sena.bovinnet</groupId>
    <artifactId>bovinnet-animal-web</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>BovinNet - Modulo de animales (Servlets y JSP)</name>
    <description>
        Modulo de codificacion del proyecto BovinNet correspondiente a la
        evidencia GA7-220501096-AA2-EV02: formularios HTML atendidos por
        un Servlet (metodos GET y POST) y vistas JSP, sobre la misma
        entidad Animal codificada en la evidencia GA7-220501096-AA2-EV01.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>
    </properties>

    <dependencies>
        <!-- API de Servlets: la provee el servidor (Tomcat), por eso scope "provided" -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- API de JSP: tambien la provee el servidor -->
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- Conector JDBC oficial de MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>bovinnet-animal-web</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </build>
</project>
