<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>BovinNet - Modulo de animales (Servlets y JSP)</display-name>

    <!--
        El servlet tambien esta declarado con la anotacion @WebServlet
        en AnimalServlet.java. Este bloque se deja como configuracion
        explicita de respaldo, valida para contenedores que no
        procesen anotaciones o cuando se requiera cambiar la ruta
        sin recompilar.
    -->
    <servlet>
        <servlet-name>AnimalServlet</servlet-name>
        <servlet-class>co.sena.bovinnet.web.AnimalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnimalServlet</servlet-name>
        <url-pattern>/animales</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
